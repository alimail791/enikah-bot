# --- required ---
DATABASE_URL=postgres://user:pass@host:5432/db       # Railway: ${{Postgres.DATABASE_URL}}
BASE_URL=https://enikah.vasulbook.com
ADMIN_PHONES=919445775305                           # comma-separated, country code, no +

# --- WhatsApp Cloud API (new number just for ENikah) ---
WA_TOKEN=                    # permanent system-user token
WA_PHONE_ID=                 # phone number ID (not the number itself)
WA_VERIFY_TOKEN=             # any secret string; paste the same in Meta webhook settings
WA_APP_SECRET=               # app secret, checks webhook signatures
WA_DISPLAY_NUMBER=           # e.g. 916383000000, for the wa.me link on the home page
TEMPLATE_LANG=en

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=     # webhook URL: BASE_URL/rzp/webhook, event payment_link.paid

# --- business rules (defaults shown) ---
PRICE_PERSON=2000
PRICE_BROKER=1000
MONTHLY_LIMIT=5
FREE_DAYS=30
BROKER_CAP=10

# --- testing only ---
DEV_MODE=0                   # 1 enables /dev/* test routes and /dev/pay links when Razorpay keys are empty
DRY_RUN=0                    # 1 logs messages instead of sending
