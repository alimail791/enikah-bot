# --- required ---
DATABASE_URL=postgres://user:pass@host:5432/db       # Railway: ${{Postgres.DATABASE_URL}}
BASE_URL=https://enikah.vasulbook.com
ADMIN_PHONES=919445775305                           # comma-separated, with 91, no +

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=     # webhook URL: BASE_URL/rzp/webhook, event payment_link.paid

# --- email (optional, Resend) ---
RESEND_API_KEY=
MAIL_FROM=ENikah <noreply@vasulbook.com>
ADMIN_EMAIL=alimail791@gmail.com      # gets admin alerts
CONTACT_EMAIL=alimail791@gmail.com    # shown on privacy / help pages

# --- business rules (defaults shown) ---
PRICE_PERSON=2000
PRICE_BROKER=1000
MONTHLY_LIMIT=5
FREE_DAYS=30
BROKER_CAP=10

# --- testing only ---
DEV_MODE=0                   # 1 enables /dev/* routes and fake payment links when Razorpay keys are empty

# --- search engines ---
GOOGLE_SITE_VERIFICATION=   # Search Console > HTML tag: paste only the content="..." value
INDEXNOW_OFF=               # IndexNow (Bing etc.) is pinged on every start; 1 = off
